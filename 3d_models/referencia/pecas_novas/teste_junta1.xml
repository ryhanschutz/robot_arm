<mujoco model="teste_junta1">
  <!-- Teste da Junta 1 (Base -> Tampa). STLs na origem global do CAD (mm -> m).
       Junta 1: X=-9.53 Y=2.36 Z=54.31 mm  ->  -0.00953 0.00236 0.05431 m
       O body "tampa" fica em pos=0 (as malhas já estão em coordenadas globais);
       o pivô é definido só pelo pos do <joint>.
       Tudo que vem depois da tampa (braços e garra) é filho dela e gira junto. -->
  <compiler angle="degree" meshdir="."/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
    <global offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <mesh name="base_servo"     file="Mont3 - base_Servo-1.STL"         scale="0.001 0.001 0.001"/>
    <mesh name="tampa"          file="Mont3 - tampa-1.STL"              scale="0.001 0.001 0.001"/>
    <mesh name="braco_1"        file="Mont3 - braco_1-1.STL"            scale="0.001 0.001 0.001"/>
    <mesh name="braco_2"        file="Mont3 - braco_2_correto-1.STL"    scale="0.001 0.001 0.001"/>
    <mesh name="base_garra"     file="Mont3 - base_garra-1.STL"         scale="0.001 0.001 0.001"/>
    <mesh name="garra_esquerda" file="Mont3 - garra_esquerda-1.STL"     scale="0.001 0.001 0.001"/>
    <mesh name="garra_direita"  file="Mont3 - garra_direita-1.STL"      scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <light pos="0.1 -0.2 0.5" dir="0 0.3 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="chao" type="plane" pos="0 0 0.030236" size="0.5 0.5 0.01" rgba="0.85 0.85 0.85 1"/>

    <body name="base" pos="0 0 0">
      <geom type="mesh" mesh="base_servo" rgba="0.55 0.55 0.55 1"/>

      <body name="tampa" pos="0 0 0">
        <joint name="j1_base" type="hinge" axis="0 0 1" pos="-0.00953 0.00236 0.05431" range="-90 90"/>
        <geom type="mesh" mesh="tampa"          rgba="0.10 0.10 0.10 1"/>
        <geom type="mesh" mesh="braco_1"        rgba="0.00 0.65 0.92 1"/>
        <geom type="mesh" mesh="braco_2"        rgba="0.00 0.30 0.80 1"/>
        <geom type="mesh" mesh="base_garra"     rgba="0.60 0.20 0.80 1"/>
        <geom type="mesh" mesh="garra_esquerda" rgba="0.90 0.15 0.15 1"/>
        <geom type="mesh" mesh="garra_direita"  rgba="0.15 0.75 0.20 1"/>
      </body>
    </body>
  </worldbody>
</mujoco>

