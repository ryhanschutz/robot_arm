<mujoco model="robot_arm_4dof">
  <compiler angle="degree" meshdir="assets" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1280" offheight="960"/>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <default>
    <default class="arm">
      <geom type="mesh" contype="0" conaffinity="0"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4" width="512" height="512" mark="edge" markrgb="0.8 0.8 0.8"/>
    <material name="grid_mat" texture="grid" texrepeat="2 2" texuniform="true" reflectance="0.2"/>

    <material name="mat_weg_blue" rgba="0.0 0.38 0.72 1.0" specular="0.5" shininess="0.5"/>
    <material name="mat_arm_cyan" rgba="0.0 0.65 0.92 1.0" specular="0.6" shininess="0.6"/>
    <material name="mat_dark_joint" rgba="0.15 0.15 0.15 1.0" specular="0.3" shininess="0.4"/>
    <material name="mat_gripper" rgba="0.88 0.22 0.22 1.0" specular="0.4" shininess="0.5"/>

    <!-- STLs exportados da montagem (mm -> m) -->
    <mesh name="mesh_base"       file="base.STL"           scale="0.001 0.001 0.001"/>
    <mesh name="mesh_tampa"      file="tampa.STL"          scale="0.001 0.001 0.001"/>
    <mesh name="mesh_braco_1"    file="braco_1.STL"        scale="0.001 0.001 0.001"/>
    <mesh name="mesh_braco_2"    file="braco_2.STL"        scale="0.001 0.001 0.001"/>
    <mesh name="mesh_base_garra" file="base_garra.STL"     scale="0.001 0.001 0.001"/>
    <mesh name="mesh_garra_dir"  file="garra_direita.STL"  scale="0.001 0.001 0.001"/>
    <mesh name="mesh_garra_esq"  file="garra_esquerda.STL" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <geom name="floor" size="1 1 0.05" type="plane" material="grid_mat"/>

    <body name="target_cube" pos="0 0.09 0.012">
      <joint type="free"/>
      <geom name="target_geom" type="box" size="0.012 0.012 0.012" rgba="0.1 0.85 0.2 1.0" mass="0.02"/>
    </body>

    <!-- O pos desloca a montagem inteira para o eixo de J1 ficar na origem do mundo.
         Tudo abaixo está nas coordenadas da montagem do SolidWorks (metros). -->
    <body name="base_link" pos="-0.0225 -0.0225 0" childclass="arm">
      <geom mesh="mesh_base" material="mat_weg_blue"/>

      <!-- J1: giro vertical. X Y = centro do eixo da base (usei o centro da base, 22.5 mm) -->
      <body name="tampa">
        <joint name="joint_base" type="hinge" axis="0 0 1" pos="0.0225 0.0225 0" range="-90 90" damping="0.1"/>
        <geom mesh="mesh_tampa" material="mat_dark_joint"/>

        <!-- J2: ombro. ESTIMATIVA, remedir X e Y na montagem -->
        <body name="braco_1">
          <joint name="joint_ombro" type="hinge" axis="1 0 0" pos="0.0132 0.0300 0.0477" range="-60 85" damping="0.1"/>
          <geom mesh="mesh_braco_1" material="mat_arm_cyan"/>

          <!-- J3: cotovelo. ESTIMATIVA, remedir X e Y na montagem -->
          <body name="braco_2">
            <joint name="joint_cotovelo" type="hinge" axis="1 0 0" pos="0.0092 0.0100 0.0935" range="-90 60" damping="0.1"/>
            <geom mesh="mesh_braco_2" material="mat_weg_blue"/>

            <!-- Garra rígida até medirmos o pino de giro dos dedos -->
            <geom mesh="mesh_base_garra" material="mat_dark_joint"/>
            <geom mesh="mesh_garra_esq"  material="mat_gripper"/>
            <geom mesh="mesh_garra_dir"  material="mat_gripper"/>

            <!-- TCP na ponta dos dedos (Y máx. da malha ~ 89.4 mm) -->
            <site name="gripper_tcp" pos="0.0071 0.0894 0.0825" size="0.005" rgba="1 1 0 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- MG996R nas juntas principais; ajuste forcerange se usar MG90S -->
  <actuator>
    <position name="act_base"     joint="joint_base"     kp="1.5" kv="0.15" forcerange="-0.216 0.216" ctrlrange="-1.5708 1.5708"/>
    <position name="act_ombro"    joint="joint_ombro"    kp="2.0" kv="0.2"  forcerange="-0.216 0.216" ctrlrange="-1.0472 1.4835"/>
    <position name="act_cotovelo" joint="joint_cotovelo" kp="2.0" kv="0.2"  forcerange="-0.216 0.216" ctrlrange="-1.5708 1.0472"/>
  </actuator>

  <sensor>
    <framepos name="tcp_position" objtype="site" objname="gripper_tcp"/>
  </sensor>
</mujoco>