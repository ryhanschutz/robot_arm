<mujoco model="robot_arm_digital_twin">
  <!-- Gêmeo Digital Completo (Mont3) — Servos MG90 (-90° a +90°) + Física de Contato e Bolinha.
       Coordenadas das juntas extraídas dos eixos cilíndricos reais das malhas exportadas:
       - J1 (Base -> Tampa, giro Z):          CAD=(-9.53, 2.36, 54.31)          -> STL pos="0.022828 0.051405 0.054312"
       - J2 (Tampa -> Braço 1, giro X):       CAD=(2.50, 8.7746, 77.5862)       -> STL pos="0.034824 0.057804 0.077586"
       - J3 (Braço 1 -> Braço 2, giro X):     CAD=(-9.3961, -36.9681, 123.3752) -> STL pos="0.022953 0.012061 0.123375"
       - J4_esq (Base Garra -> Dedo Esq, Z):  CAD=(-18.3747, 44.7573, 113.5454) -> STL pos="0.013974 0.093787 0.113545"
       - J4_dir (Base Garra -> Dedo Dir, Z):  CAD=(0.1253, 44.7573, 113.5454)   -> STL pos="0.032474 0.093787 0.113545"
  -->
  <compiler angle="degree" meshdir="../meshes" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.75 0.75 0.75" specular="0.25 0.25 0.25"/>
    <global offwidth="1280" offheight="960"/>
  </visual>

  <default>
    <geom contype="0" conaffinity="0" friction="1.5 0.02 0.01" solref="0.008 1" solimp="0.95 0.99 0.001"/>
    <!-- Amortecimento e inércia calibrados para movimento suave dos servos MG90 (baixa sensibilidade) -->
    <joint damping="0.16" armature="0.003" frictionloss="0.006"/>
    <!-- Colisores físicos da garra totalmente invisíveis (group="4" e alpha=0) -->
    <default class="finger_pad">
      <geom type="capsule" size="0.0022" group="4" contype="1" conaffinity="1" rgba="0 0 0 0" friction="2.5 0.05 0.02" condim="4"/>
    </default>
  </default>

  <asset>
    <material name="azul_base"  rgba="0.04 0.34 0.70 1" specular="0.4" shininess="0.5"/>
    <material name="azul_tampa" rgba="0.02 0.42 0.80 1" specular="0.4" shininess="0.5"/>
    <material name="azul_elo1"  rgba="0.00 0.54 0.92 1" specular="0.5" shininess="0.6"/>
    <material name="azul_elo2"  rgba="0.00 0.46 0.86 1" specular="0.5" shininess="0.6"/>
    <material name="azul_garra" rgba="0.05 0.60 0.96 1" specular="0.5" shininess="0.6"/>

    <mesh name="base_servo"     file="base_servo.stl"     scale="0.001 0.001 0.001"/>
    <mesh name="tampa"          file="tampa.stl"          scale="0.001 0.001 0.001"/>
    <mesh name="braco_1"        file="braco_1.stl"        scale="0.001 0.001 0.001"/>
    <mesh name="braco_2"        file="braco_2.stl"        scale="0.001 0.001 0.001"/>
    <mesh name="base_garra"     file="base_garra.stl"     scale="0.001 0.001 0.001"/>
    <mesh name="garra_esquerda" file="garra_esquerda.stl" scale="0.001 0.001 0.001"/>
    <mesh name="garra_direita"  file="garra_direita.stl"  scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <light pos="0.1 -0.2 0.5" dir="0 0.3 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="chao" type="plane" pos="0 0 0.030236" size="0.5 0.5 0.01" contype="1" conaffinity="1" rgba="0.88 0.88 0.88 1" friction="1.5 0.08 0.04" solref="0.012 1.2"/>

    <!-- Marcadores visuais sutis das zonas de coleta/soltura no chão -->
    <geom name="zona_centro"   type="cylinder" pos="0.02355 0.1558 0.0303" size="0.016 0.0002" rgba="0.20 0.65 0.95 0.35"/>
    <geom name="zona_esquerda" type="cylinder" pos="-0.0415 0.1310 0.0303" size="0.016 0.0002" rgba="0.25 0.80 0.40 0.35"/>
    <geom name="zona_direita"  type="cylinder" pos="0.0878  0.1308 0.0303" size="0.016 0.0002" rgba="0.95 0.55 0.20 0.35"/>

    <!-- Elo 0: Base fixa -->
    <body name="base" pos="0 0 0">
      <geom type="mesh" mesh="base_servo" material="azul_base"/>

      <!-- Elo 1: Tampa giratória (J1 - Servo MG90 Base: -90° a +90° em Z) -->
      <body name="tampa" pos="0 0 0">
        <joint name="j1_base" type="hinge" axis="0 0 1" pos="0.022828 0.051405 0.054312" range="-90 90"/>
        <geom type="mesh" mesh="tampa" material="azul_tampa"/>

        <!-- Elo 2: Braço 1 (J2 - Servo MG90 Ombro: limite seguro -72° a +60° em X) -->
        <body name="braco_1" pos="0 0 0">
          <joint name="j2_ombro" type="hinge" axis="1 0 0" pos="0.034824 0.057804 0.077586" range="-72 60"/>
          <geom type="mesh" mesh="braco_1" material="azul_elo1"/>

          <!-- Elo 3: Braço 2 + Suporte da Garra (J3 - Servo MG90 Cotovelo: limite seguro -35° a +65° em X) -->
          <body name="braco_2" pos="0 0 0">
            <joint name="j3_cotovelo" type="hinge" axis="1 0 0" pos="0.022953 0.012061 0.123375" range="-35 65"/>
            <geom type="mesh" mesh="braco_2"    material="azul_elo2"/>
            <geom type="mesh" mesh="base_garra" material="azul_tampa"/>
            <site name="grip_center" pos="0.02355 0.12649 0.10696" size="0.0025" group="4" rgba="0 0 0 0"/>

            <!-- Dedo Esquerdo (J4_esq - Giro em +Z: 0° fechada view_mockup a +38° aberta) -->
            <body name="garra_esquerda" pos="0 0 0">
              <joint name="j4_garra_esq" type="hinge" axis="0 0 1" pos="0.013974 0.093787 0.113545" range="0 38"/>
              <geom type="mesh" mesh="garra_esquerda" material="azul_garra"/>
              <!-- Colisores invisíveis para preensão física estável da bolinha -->
              <geom class="finger_pad" fromto="0.016 0.108 0.1075 0.013 0.126 0.1075"/>
              <geom class="finger_pad" fromto="0.016 0.108 0.1170 0.013 0.126 0.1170"/>
              <geom class="finger_pad" fromto="0.013 0.126 0.1075 0.022 0.140 0.1075"/>
              <geom class="finger_pad" fromto="0.013 0.126 0.1170 0.022 0.140 0.1170"/>
            </body>

            <!-- Dedo Direito (J4_dir - Giro em -Z: 0° fechada view_mockup a +38° aberta) -->
            <body name="garra_direita" pos="0 0 0">
              <joint name="j4_garra_dir" type="hinge" axis="0 0 -1" pos="0.032474 0.093787 0.113545" range="0 38"/>
              <geom type="mesh" mesh="garra_direita" material="azul_garra"/>
              <!-- Colisores invisíveis para preensão física estável da bolinha -->
              <geom class="finger_pad" fromto="0.031 0.108 0.1075 0.034 0.126 0.1075"/>
              <geom class="finger_pad" fromto="0.031 0.108 0.1170 0.034 0.126 0.1170"/>
              <geom class="finger_pad" fromto="0.034 0.126 0.1075 0.025 0.140 0.1075"/>
              <geom class="finger_pad" fromto="0.034 0.126 0.1170 0.025 0.140 0.1170"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Bolinha interativa para o desafio de pick-and-place -->
    <body name="bolinha" pos="0.02355 0.1558 0.0410">
      <joint name="bolinha_free" type="free" damping="0.0012"/>
      <geom name="bolinha_geom" type="sphere" size="0.0105" mass="0.004" contype="1" conaffinity="1" rgba="1.0 0.45 0.05 1.0" friction="2.5 0.08 0.04" condim="4"/>
    </body>
  </worldbody>

  <!-- Acoplamento por engrenagem entre os dois dedos da garra (abrem e fecham simetricamente) -->
  <equality>
    <joint joint1="j4_garra_dir" joint2="j4_garra_esq" polycoef="0 1 0 0 0" solref="0.004 1" solimp="0.98 0.995 0.0005"/>
  </equality>

  <!-- Atuadores de posição calibrados para Servos MG90 com limites anti-colisão:
       ctrlrange em radianos: J1 [-90°,+90°], J2 [-72°,+60°], J3 [-35°,+65°], J4 [0°,+38°] -->
  <actuator>
    <position name="servo_j1_base"     joint="j1_base"      kp="4.5" kv="0.30" forcerange="-0.50 0.50" ctrlrange="-1.5708 1.5708"/>
    <position name="servo_j2_ombro"    joint="j2_ombro"     kp="6.5" kv="0.38" forcerange="-0.65 0.65" ctrlrange="-1.2566 1.0472"/>
    <position name="servo_j3_cotovelo" joint="j3_cotovelo"  kp="6.5" kv="0.38" forcerange="-0.65 0.65" ctrlrange="-0.6109 1.1345"/>
    <position name="servo_j4_garra"    joint="j4_garra_esq" kp="3.5" kv="0.20" forcerange="-0.40 0.40" ctrlrange="0.0000 0.6632"/>
  </actuator>
</mujoco>
