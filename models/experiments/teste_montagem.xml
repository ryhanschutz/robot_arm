<mujoco model="teste_montagem">
  <!-- Mockup estático: STLs exportados da Mont3 (origem global comum, em mm -> m).
       meshdir="../../meshes" = mesma pasta deste XML. -->
  <compiler angle="degree" meshdir="../../meshes"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
    <global offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <mesh name="base_servo"     file="base_servo.stl"         scale="0.001 0.001 0.001"/>
    <mesh name="tampa"          file="tampa.stl"              scale="0.001 0.001 0.001"/>
    <mesh name="braco_1"        file="braco_1.stl"            scale="0.001 0.001 0.001"/>
    <mesh name="braco_2"        file="braco_2.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="base_garra"     file="base_garra.stl"         scale="0.001 0.001 0.001"/>
    <mesh name="garra_esquerda" file="garra_esquerda.stl"     scale="0.001 0.001 0.001"/>
    <mesh name="garra_direita"  file="garra_direita.stl"      scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <light pos="0.1 -0.2 0.5" dir="0 0.3 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="chao" type="plane" pos="0 0 0.030236" size="0.5 0.5 0.01" rgba="0.85 0.85 0.85 1"/>

    <body name="montagem_fixa" pos="0 0 0">
      <geom type="mesh" mesh="base_servo"     rgba="0.55 0.55 0.55 1"/> <!-- cinza -->
      <geom type="mesh" mesh="tampa"          rgba="0.10 0.10 0.10 1"/> <!-- preto -->
      <geom type="mesh" mesh="braco_1"        rgba="0.00 0.65 0.92 1"/> <!-- ciano -->
      <geom type="mesh" mesh="braco_2"        rgba="0.00 0.30 0.80 1"/> <!-- azul -->
      <geom type="mesh" mesh="base_garra"     rgba="0.60 0.20 0.80 1"/> <!-- roxo -->
      <geom type="mesh" mesh="garra_esquerda" rgba="0.90 0.15 0.15 1"/> <!-- vermelho -->
      <geom type="mesh" mesh="garra_direita"  rgba="0.15 0.75 0.20 1"/> <!-- verde -->
    </body>
  </worldbody>
</mujoco>

