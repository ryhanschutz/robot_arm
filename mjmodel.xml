<mujoco model="teste_montagem">
  <!-- Mockup estático: STLs exportados da Mont3 (origem global comum, em mm -> m).
       meshdir="." = mesma pasta deste XML. -->
  <compiler angle="radian" meshdir="."/>

  <visual>
    <global offwidth="1280" offheight="960"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <mesh name="base_servo" content_type="model/stl" file="Mont3 - base_Servo-1.STL" scale="0.001 0.001 0.001"/>
    <mesh name="tampa" content_type="model/stl" file="Mont3 - tampa-1.STL" scale="0.001 0.001 0.001"/>
    <mesh name="braco_1" content_type="model/stl" file="Mont3 - braco_1-1.STL" scale="0.001 0.001 0.001"/>
    <mesh name="braco_2" content_type="model/stl" file="Mont3 - braco_2_correto-1.STL" scale="0.001 0.001 0.001"/>
    <mesh name="base_garra" content_type="model/stl" file="Mont3 - base_garra-1.STL" scale="0.001 0.001 0.001"/>
    <mesh name="garra_esquerda" content_type="model/stl" file="Mont3 - garra_esquerda-1.STL" scale="0.001 0.001 0.001"/>
    <mesh name="garra_direita" content_type="model/stl" file="Mont3 - garra_direita-1.STL" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <geom name="chao" size="0.5 0.5 0.01" pos="0 0 0.030236" type="plane" rgba="0.85 0.85 0.85 1"/>
    <light pos="0.1 -0.2 0.5" dir="0 0.287348 -0.957826" diffuse="0.8 0.8 0.8"/>
    <body name="montagem_fixa">
      <geom pos="0 0 0" quat="1 0 0 0" type="mesh" rgba="0.55 0.55 0.55 1" mesh="base_servo"/>
      <geom quat="1 0 0 0" type="mesh" rgba="0.1 0.1 0.1 1" mesh="tampa"/>
      <geom pos="0 0 0" quat="1 0 0 0" type="mesh" rgba="0 0.65 0.92 1" mesh="braco_1"/>
      <geom pos="0 0 0" quat="1 0 0 0" type="mesh" rgba="0 0.3 0.8 1" mesh="braco_2"/>
      <geom pos="0 0 0" quat="1 0 0 0" type="mesh" rgba="0.6 0.2 0.8 1" mesh="base_garra"/>
      <geom pos="0 0 0" quat="1 0 0 0" type="mesh" rgba="0.9 0.15 0.15 1" mesh="garra_esquerda"/>
      <geom pos="0 0 0" quat="1 0 0 0" type="mesh" rgba="0.15 0.75 0.2 1" mesh="garra_direita"/>
    </body>
  </worldbody>
</mujoco>
